# 深度健檢的 Schema／E-E-A-T 語意判斷用 GPT-4o（走 OpenRouter）。
# 沒設這個 key 時，這兩項會自動回退成「未經 AI 判斷」，不影響其他檢測。
OPENROUTER_API_KEY=

# ── Google 登入（Google Cloud Console → API 和服務 → 憑證 → OAuth 用戶端 ID，類型選「網頁應用程式」）──
# 已授權的重新導向 URI 要加：
#   https://geo.stack.com.tw/api/auth/google/callback
#   http://localhost:5050/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 簽登入 cookie 用：openssl rand -hex 32
AUTH_SECRET=
# 對外網址（正式站可不填，預設 https://geo.stack.com.tw）
AUTH_URL=
# 不限次數的帳號，逗號分隔
ADMIN_EMAILS=

# ── 免費次數紀錄：正式站用 Railway Postgres（加 Postgres 服務後引用它的 DATABASE_URL）──
# 本機不填就存在 .data/usage.json
DATABASE_URL=
